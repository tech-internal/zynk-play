# .env.example
# Environment variables template - Copy to .env and fill in your values

# =====================================================================
# DJANGO SETTINGS
# =====================================================================
SECRET_KEY=your-very-secret-key-change-this
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# =====================================================================
# DATABASE
# =====================================================================
# Use PostgreSQL: set DB_ENGINE + DB_NAME (and user/password/host). Then run:
#   createdb entertainment_platform   (or CREATE DATABASE in psql)
#   python manage.py migrate
#   python manage.py seed_subscription_plans
#
# Omit DB_NAME (or leave empty) to fall back to SQLite (db.sqlite3).
DB_ENGINE=django.db.backends.postgresql
DB_NAME=zynk_play
DB_USER=zynk_app
DB_PASSWORD=change_me_to_a_strong_secret
DB_HOST=127.0.0.1
# Optional persistent connections (seconds); 60 recommended for remote PostgreSQL
DB_CONN_MAX_AGE=60

# =====================================================================
# REDIS CACHE & CELERY
# =====================================================================
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# =====================================================================
# OTP SETTINGS
# =====================================================================
OTP_VALIDITY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_MINUTES=1

# =====================================================================
# FREE TRIAL SETTINGS
# =====================================================================
FREE_TRIAL_DURATION_MINUTES=5

# =====================================================================
# STREAMING SETTINGS
# =====================================================================
STREAM_BASE_URL=https://stream.yourdomain.com
SIGNED_URL_VALIDITY_SECONDS=300

# =====================================================================
# SMS CONFIGURATION (For OTP delivery)
# Example: Twilio, AWS SNS, Local SMS Provider
# =====================================================================
SMS_SERVICE_URL=https://sms-api.yourprovider.com/send
SMS_API_KEY=your_sms_api_key_here

# =====================================================================
# PAYMENT GATEWAY INTEGRATION
# Configure with your payment provider (e.g., AFPay, M-Pesa, Stripe)
# =====================================================================
PAYMENT_PROVIDER_URL=https://api.paymentprovider.com/payment
PAYMENT_API_KEY=your_payment_api_key_here
PAYMENT_MERCHANT_ID=your_merchant_id_here
PAYMENT_WEBHOOK_SECRET=your_webhook_secret_key_here
# Optional: separate secret for mock Palzio PSP (checkout token + webhook). If empty, PAYMENT_WEBHOOK_SECRET is used.
PALZIO_PSP_SHARED_SECRET=
# Checkout token lifetime in seconds (default 3600)
PALZIO_CHECKOUT_TTL_SECONDS=3600
# Optional: full URL for payment webhooks when the PSP runs as a separate service. Leave empty when PSP is in-process (default).
PLATFORM_PAYMENT_WEBHOOK_URL=

# =====================================================================
# SITE CONFIGURATION
# =====================================================================
# Local API + Swagger Try it out (use your real public URL in production)
SITE_URL=http://localhost:8000
SITE_NAME=Entertainment Platform

# =====================================================================
# SECURITY SETTINGS
# =====================================================================
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# =====================================================================
# CORS CONFIGURATION
# =====================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# =====================================================================
# LOGGING CONFIGURATION
# =====================================================================
LOG_LEVEL=INFO
LOG_FILE_PATH=/var/log/entertainment-platform/platform.log

# =====================================================================
# AWS S3 (Reels storage)
# =====================================================================
AWS_ACCESS_KEY_ID=your_aws_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_STORAGE_BUCKET_NAME=your_bucket_name
AWS_S3_REGION_NAME=ap-southeast-2

# Frontend direct S3 URLs (optional; proxy fallback works without these)
REACT_APP_AWS_S3_BUCKET=your_bucket_name
REACT_APP_AWS_S3_REGION=ap-southeast-2

# =====================================================================
# XP INTEGRATION DOCS (Partner portal — password protected)
# =====================================================================
# Interactive docs + API playground: https://yourdomain.com/xp/integration/
# Disabled until XP_DOCS_PASSWORD is set. Share URL + username/password with integrators only.
XP_DOCS_ENABLED=True
XP_DOCS_USERNAME=xp-integration
XP_DOCS_PASSWORD=change_me_strong_partner_password

# =====================================================================
# MONITORING & ANALYTICS (Optional)
# =====================================================================
SENTRY_DSN=your_sentry_dsn_for_error_tracking
GOOGLE_ANALYTICS_ID=your_ga_tracking_id
