# Copy to .env in this folder:  cp env.example .env
# PostgreSQL creates DB + superuser role from these on first volume init.

POSTGRES_USER=zynk_app
POSTGRES_PASSWORD=change_me_to_a_strong_secret
POSTGRES_DB=zynk_play

# Host port (container always listens on 5432). Use 5433 if your machine already uses 5432.
POSTGRES_PUBLISH_PORT=5433
